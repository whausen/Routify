# Kopieren nach .env und Werte eintragen. .env wird nicht committet. Alles hier ist optional.

# OpenCycleMap-Hintergrundkarte (kostenloser Hobby-Key: https://manage.thunderforest.com)
THUNDERFOREST_KEY=

# Cloudflare Turnstile für Anmeldung und Registrierung.
# Aktiviere beide Schlüssel zusammen mit dem erlaubten Hostnamen.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAME=routify-dev.hack4gdi.de

# Straßenfotos (Mapillary): eigenen CLIENT TOKEN eintragen (https://www.mapillary.com/dashboard/developers),
# nicht das Client secret. Ohne Token ist die Karte „Straßenfotos“ ausgeblendet.
# MAPILLARY_TOKEN=MLY|...

# LLM / Dienste umstellen
# OLLAMA_URL=http://localhost:11434
# LLM_MODEL=qwen3:8b          # schwächere Laptops: qwen3:4b (vorher: ollama pull qwen3:4b)
# BROUTER_URL=http://localhost:17777
# WHISPER_MODELL=small        # base = schneller, ungenauer
